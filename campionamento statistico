# 2. Definizione del modello PyMC
with pm.Model() as model:
    # Priors per i parametri (distribuzioni a priori)
    # alpha ~ N(0, 1)
    alpha = pm.Normal('alpha', mu=0, sigma=1)
    
    # beta ~ N(1, 1)
    beta = pm.Normal('beta', mu=1, sigma=1)
    
    # gamma ~ Exp(lambda=1)
    gamma = pm.Exponential('gamma', lam=1)
    
    # Definizione della media deterministica: mu = alpha + beta * S
    mu = alpha + beta * S
    
    # Likelihood (Verosimiglianza): i dati osservati seguono una Normale
    # con media mu e deviazione standard gamma
    y = pm.Normal('y', mu=mu, sigma=gamma, observed=y_obs)
    
    # 3. Campionamento (Inference)
    # draws=1000 genera 1000 campioni dalla distribuzione a posteriori
    trace = pm.sample(1000, tune=1000, return_inferencedata=True)

# 4. Visualizzazione della distribuzione a posteriori
az.plot_posterior(trace, var_names=['alpha', 'beta', 'gamma'])
